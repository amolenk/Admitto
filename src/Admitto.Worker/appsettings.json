{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Azure.Messaging.ServiceBus": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "Email": {
    "Reconfirmation": {
      "Interval": "01:00:00"
    }
  },
  "Registrations": {
    "VerificationToken": {
      "SigningKey": "",
      "TokenTtlMinutes": 15
    },
    "Otp": {
      "ExpiryMinutes": 10,
      "RateLimitWindowMinutes": 10,
      "MaxRequestsPerWindow": 3
    }
  }
}
