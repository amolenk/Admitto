{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Azure.Messaging.ServiceBus": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Public": {
      "Strict": {
        "PermitLimit": 120,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6,
        "QueueLimit": 0
      },
      "Standard": {
        "PermitLimit": 600,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6,
        "QueueLimit": 0
      }
    }
  },
  "Organization": {
    "Caching": {
      "Enabled": true
    }
  },
  "Registrations": {
    "VerificationToken": {
      "SigningKey": "",
      "TokenTtlMinutes": 15
    },
    "Otp": {
      "ExpiryMinutes": 10,
      "RateLimitWindowMinutes": 10,
      "MaxRequestsPerWindow": 3
    }
  }
}
