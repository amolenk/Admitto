{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Authentication": {
    "Bearer": {
      "Authority": "<Injected by AppHost>",
      "TokenValidationParameters": {
        "ValidAudience": "admitto-api"
      }
    }
  },
  "Organization": {
    "Caching": {
      "Enabled": true
    }
  }
}
