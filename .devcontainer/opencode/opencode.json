            "output": ["text"]
          }
        },
        "gpt-5.6-terra-amolenk": {
          "id": "gpt-5.6-terra-amolenk",
          "name": "gpt-5.6-terra-amolenk",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5.6-luna-amolenk": {
          "id": "gpt-5.6-luna-amolenk",
          "name": "gpt-5.6-luna-amolenk",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "model": "amolenk/gpt-5.6-terra-amolenk",
  "plugin": [
    "oh-my-opencode-slim"
