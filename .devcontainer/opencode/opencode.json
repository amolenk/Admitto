{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amolenk": {
      "name": "amolenk (Foundry)",
      "npm": "@ai-sdk/openai",
      "api": "https://amolenk-ai.services.ai.azure.com/openai/v1",
      "models": {
        "gpt-5.6-sol-amolenk": {
          "id": "gpt-5.6-sol-amolenk",
          "name": "gpt-5.6-sol-amolenk",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "modalities": {
