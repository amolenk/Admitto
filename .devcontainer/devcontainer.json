{
	"name": "Admitto",
	"image": "mcr.microsoft.com/devcontainers/dotnet:dev-10.0-noble",
    "runArgs": ["--name", "admitto-devcontainer"],
	"features": {
		"ghcr.io/microsoft/aspire-devcontainer-feature/aspire:2": {},
		"ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {},
		"ghcr.io/devcontainers/features/powershell:2.0.2": {},
		"ghcr.io/devcontainers/features/node:2.1.0": {},
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers-extra/features/uv:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	"hostRequirements": {
		"cpus": 4,
		"memory": "16gb",
		"storage": "32gb"
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [5000, 5001],
	// "portsAttributes": {
	//		"5001": {
	//			"protocol": "https"
	//		}
	// }

    "workspaceMount": "source=admitto-workspace,target=/workspace,type=volume",
    "workspaceFolder": "/workspace/admitto",

    "mounts": [
        "source=claude-code-config,target=/home/vscode/.claude,type=volume",
        "source=${localEnv:HOME}/AGENTS.md,target=/home/vscode/AGENTS.md,type=bind,ro",
        "source=${localEnv:HOME}/AGENTS.md,target=/home/vscode/CLAUDE.md,type=bind,ro"
    ],

    "containerEnv": {
        // Point the Claude CLI to the config directory inside the container
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "dotnet restore",
    "remoteEnv": {
      "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/etc/ssl/certs"
    },

    "postStartCommand": {
        "trust-dotnet-dev-cert": "dotnet dev-certs https --trust",
        "fix-claude-permissions": "sudo chown -R vscode:vscode /home/vscode/.claude",
        "fix-workspace-permissions": "sudo chown -R vscode:vscode /workspace"
    },

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"GitHub.copilot-chat",
				"microsoft-aspire.aspire-vscode"
			]
		}
	}
	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}